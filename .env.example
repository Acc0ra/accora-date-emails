# HubSpot private app token. Scopes needed: crm.objects.companies.read,
# crm.objects.contacts.read, crm.objects.contacts.write, crm.lists.read.
# No sequence scopes and no crm.schemas.contacts.write.
HUBSPOT_TOKEN=

# Portal ID, for the masthead / log only (not sent to HubSpot).
HUBSPOT_PORTAL_ID=25005558

# The role-based permanent exclusion list (HubSpot list ID). Required —
# there is no safe default. Ask whoever owns the do-not-email list on this portal.
EXCLUSION_LIST_ID=

# Hard-bounce property for this portal. UNCONFIRMED — see brief section
# "Open — needs Alex": confirm the actual property name and, if it isn't a
# plain boolean, adjust HUBSPOT_HARD_BOUNCE_TRUE_VALUES below.
# hs_email_hard_bounce_reason is a non-empty enumeration when a contact has
# hard-bounced; that's the working assumption until confirmed.
HUBSPOT_HARD_BOUNCE_PROPERTY=hs_email_hard_bounce_reason

# Days since date_email_last_sent that counts as "too recent to re-queue".
# Brief flags this 60-day default as open given a ~20-patch monthly rotation.
TRANSIENT_WINDOW_DAYS=60

# Contacts written per run before the remainder is held for next time.
SEND_CAP=1000

# Optional: POSTs a short message here on batch-write failure (Slack incoming
# webhook works as-is). Leave blank to skip — failures still show loudly in
# the run report either way.
ALERT_WEBHOOK_URL=

PORT=10000
